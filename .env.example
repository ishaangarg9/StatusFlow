# App connects as the RESTRICTED app_user role (no BYPASSRLS, no DDL).
DATABASE_URL=postgres://app_user:devpassword@localhost:5433/statusflow?sslmode=disable

# Migrations use a separate privileged role.
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5433/statusflow?sslmode=disable

API_ADDR=:8080
# Dedicated, non-public listener for /healthz, /readyz, /metrics (internal/ops).
# Keep it OFF the public ingress. Running api+worker on one host? Override one of
# them (e.g. the worker) so the two ops servers don't clash on the same port.
OPS_ADDR=:9090

SESSION_TTL_DAYS=14
SESSION_COOKIE_NAME=sf_session
SESSION_COOKIE_SECURE=false

WORKER_TICK_MS=5000
WORKER_BATCH=50
WORKER_CONCURRENCY=20
# Claim lease: a crashed worker's monitor is re-checked after this many seconds
# instead of being skipped for a full interval. Must exceed the max monitor
# timeout (the DB floors it at timeout+30s regardless).
WORKER_CLAIM_LEASE_SECONDS=90

INCIDENT_OPEN_THRESHOLD=2
INCIDENT_RESOLVE_THRESHOLD=2

RATE_LIMIT_LOGIN_PER_MIN=10
# Per-IP cap on POST /api/invitations/accept (online token-guessing surface).
RATE_LIMIT_ACCEPT_PER_MIN=20

# Invitation delivery (worker). Leave RESEND_API_KEY empty to use the dev
# filesystem outbox; set it (and RESEND_FROM) to deliver real email via Resend.
RESEND_API_KEY=
RESEND_FROM=StatusFlow <noreply@statusflow.example>
# App base URL used to build a clickable accept link in the invitation email.
# If empty, the email carries the raw token + API path instead.
APP_BASE_URL=

# Frontend (Next.js) — see web/.env.example. The browser never talks to the Go
# API directly (ADR-11): the Next BFF forwards requests server-side, so the API
# origin is a SERVER-ONLY var (INTERNAL_API_URL), not NEXT_PUBLIC_*.
