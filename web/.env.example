# StatusFlow web (Next.js) environment.
#
# ADR-11: the browser only ever talks to the Next origin. The BFF
# (app/bff/[...path]/route.ts) and server components forward requests to the Go
# API server-side, so the API origin is SERVER-ONLY — never NEXT_PUBLIC_*.

# Where the Go API listens, as seen from the Next server process.
# NOTE: the API's API_ADDR default is :8080, but the local dev API commonly runs
# on :8081 — verify the running port and set this accordingly.
INTERNAL_API_URL=http://localhost:8081

# This app's own public origin. Used by the BFF's CSRF/Origin allowlist for
# state-changing requests. In dev it's derived from the request; set it
# explicitly in production (e.g. https://statusflow.example.com).
APP_ORIGIN=
