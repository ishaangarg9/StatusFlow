# AppArmor profile for multi-process pods (Postgres) on Ubuntu 26.04 + k3s.
#
# Why this exists: on this kernel/runc combination every container ends up with
# the STACKED label `cri-containerd.apparmor.d//&unconfined`, but containerd's
# built-in profile only allows `signal peer=cri-containerd.apparmor.d`. So a
# process can't signal its siblings, and Postgres' startup process dies with
# "could not signal for checkpoint: Permission denied" (dmesg: apparmor="DENIED"
# operation="signal" peer="cri-containerd.apparmor.d//&unconfined").
#
# This is containerd's default profile, renamed, plus the rule allowing signals
# to the stacked form of itself. Everything else (deny mount, /proc and /sys
# write restrictions, etc.) is unchanged, so AppArmor stays enforcing. Pods opt
# in via securityContext.appArmorProfile {type: Localhost, localhostProfile:
# statusflow-default}. Installed + loaded by prep-host.sh.

#include <tunables/global>

profile statusflow-default flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Host (privileged) processes and the runtime may signal container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,

  # Container processes may signal amongst themselves — including the stacked
  # label the kernel actually assigns them here.
  signal (send,receive) peer=statusflow-default,
  signal (send,receive) peer=statusflow-default//&unconfined,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=statusflow-default,
  ptrace (trace,read,tracedby,readby) peer=statusflow-default//&unconfined,
}
