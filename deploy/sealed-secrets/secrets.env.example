# StatusFlow P12 — plaintext inputs for seal.sh. COPY to secrets.env and fill in.
#
#   cp secrets.env.example secrets.env && $EDITOR secrets.env
#
# secrets.env is gitignored — it must NEVER be committed. seal.sh reads it,
# builds each Secret, and pipes it through kubeseal to produce the encrypted
# SealedSecrets under sealed/ (which ARE safe to commit).

# --- Postgres roles (the two-role tenancy split) --------------------------
# superuser == privileged migration role; app_user == NOSUPERUSER/NOBYPASSRLS.
# Generate strong values, e.g.  openssl rand -base64 24
POSTGRES_SUPERUSER_PASSWORD=
APP_USER_PASSWORD=

# --- Stripe (TEST mode for the demo) + Resend -----------------------------
# Leave ALL of STRIPE_* empty to run billing inert (Free-only). If you set the
# secret key you must set all four (the Go config fails fast on a half setup).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Resend: leave empty to use the worker's filesystem outbox instead of email.
RESEND_API_KEY=

# --- Cloudflare Tunnel ----------------------------------------------------
# Path to the credentials JSON written by `cloudflared tunnel create statusflow`
# (typically ~/.cloudflared/<TUNNEL_ID>.json). Sealed into cloudflared-credentials.
TUNNEL_CREDENTIALS_FILE=
