# Multi-stage build for the Next.js BFF (web/). Produces a slim, non-root image
# that runs the standalone server bundle (next.config.mjs: output:"standalone").
#
# Build context is the web/ directory, NOT the repo root:
#   docker build -f Dockerfile.web -t statusflow-web:dev web
#
# The browser only ever talks to this origin (ADR-11). The BFF forwards to the
# Go API server-side via INTERNAL_API_URL, so the API origin stays off the
# browser. Health for k8s probes is the Next server itself on the app port.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
# corepack ships with node 22; pin pnpm from the lockfile-managed version.
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Standalone output traces only the runtime deps it actually needs.
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# Minimal runtime: just the standalone server + static assets.
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# server.js + traced node_modules, then the assets the standalone server expects
# to find on disk (.next/static and public/).
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# node:slim provides an unprivileged "node" user (uid 1000).
USER node
EXPOSE 3000
CMD ["node", "server.js"]
